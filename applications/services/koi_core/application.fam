App(
    appid="koi_core",
    name="KoiCoreSrv",
    apptype=FlipperAppType.SERVICE,
    entry_point="koi_core_srv",
    cdefines=["SRV_KOI_CORE"],
    requires=["storage"],
    provides=["koi_core_start"],
    stack_size=3 * 1024,
    order=200,
    sdk_headers=["koi_core.h", "koi_trit.h", "koi_policy.h", "koi_audit.h"],
)

App(
    appid="koi_core_start",
    apptype=FlipperAppType.STARTUP,
    entry_point="koi_core_on_system_start",
    requires=["koi_core"],
    order=90,
)
